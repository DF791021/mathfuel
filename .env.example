# Local learning database. Replace the placeholders with your local credentials.
# Keep real values in .env (ignored by Git), never in this example.
DATABASE_URL=mysql://mathfuel_app:replace_with_local_password@127.0.0.1:3307/mathfuel_dev_local
# Generate a private random value of at least 32 characters before starting.
JWT_SECRET=
VITE_APP_ID=mathfuel-local-lab
PUBLIC_APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Only for the explicitly guarded live-MySQL verification command.
# Run tests against a separate local mathfuel_test_* database.
# MATHFUEL_TEST_DATABASE_NAME=mathfuel_test_local

# The two saved missions need no payment, email, OAuth, or AI service keys.
# Configure those integrations separately when exercising their own features.
